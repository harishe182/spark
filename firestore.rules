rules_version = '2';

// Spark research data. Contains NO child names — participant IDs only — but is
// still sensitive minor research data. These rules lock everything down: only
// authenticated facilitator/researcher accounts may read or write, and the
// data shape is validated. Deploy with: firebase deploy --only firestore:rules
//
// NOTE: enable an auth provider (e.g. Email/Password for facilitators) in the
// Firebase console. With no signed-in user, all access is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    // Only signed-in research staff. Tighten further with custom claims
    // (e.g. request.auth.token.role == 'researcher') once you provision them.
    function isStaff() {
      return request.auth != null;
    }

    match /participants/{participantId} {
      allow read, write: if isStaff();
    }

    match /sessions/{sessionId} {
      allow read: if isStaff();
      // Require the core identifying fields to be present on write.
      allow write: if isStaff()
        && request.resource.data.participant_id is string
        && request.resource.data.condition in ['ai_spark', 'static_spark'];
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
